{
  "name": "myphotos",
  "productName": "MyPhotos",
  "version": "0.1.0",
  "description": "Photothèque locale pour macOS et Windows",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Dimitri Sourzac",
  "scripts": {
    "dev": "electron-vite dev -w",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "serve": "node out/main/backend.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:mac": "sh scripts/build-mac.sh",
    "build:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@hono/node-server": "^2.1.3",
    "@huggingface/transformers": "^4.3.0",
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "exifr": "^7.1.3",
    "extract-raw-preview": "^1.1.0",
    "fdir": "^6.5.0",
    "hono": "^4.13.12",
    "maplibre-gl": "^6.11.2",
    "onnxruntime-node": "1.30",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "xxhash-wasm": "^1.1.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.5.1": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
